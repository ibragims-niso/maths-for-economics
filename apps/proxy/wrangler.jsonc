{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "maths-for-economics-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    // The web app on Cloudflare Pages and its preview deployments.
    "ALLOWED_ORIGINS": "https://maths-for-economics.pages.dev,https://*.maths-for-economics.pages.dev"
  }
  // GROQ_API_KEY is a secret: `npx wrangler secret put GROQ_API_KEY`. Never put it in this file.
}
