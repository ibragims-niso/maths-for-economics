{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "maths-for-economics-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    // The web app (root wrangler.jsonc) and its preview URLs.
    "ALLOWED_ORIGINS": "https://maths-for-economics.ibragim-n.workers.dev,https://*-maths-for-economics.ibragim-n.workers.dev"
  }
  // GROQ_API_KEY is a secret: `npx wrangler secret put GROQ_API_KEY`. Never put it in this file.
}
