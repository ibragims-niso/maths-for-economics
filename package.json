{
  "name": "maths-for-economics",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:content && npm run dev -w @mfe/web",
    "dev:proxy": "npm run build:web && wrangler dev",
    "test": "npm run build:content && vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "npm run build:content && tsc -p scripts && npm run typecheck --workspaces --if-present",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:track": "tsx scripts/validate-track.ts",
    "build": "npm run validate:content && npm run build:content && npm run build -w @mfe/web",
    "build:web": "npm run build:content && npm run build -w @mfe/web",
    "build:content": "tsx scripts/build-content.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "mdast-util-to-string": "4.0.0",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
