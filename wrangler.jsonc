{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // One Worker serves the web app (apps/web, static files) and its API (apps/proxy, under /api).
  // Cloudflare builds it with `npm run build` and deploys it with `npx wrangler deploy`
  // from the repository root.
  "name": "maths-for-economics",
  "main": "./apps/proxy/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/web/dist",
    // Unknown paths (e.g. the mentor view /m/<token>) load the app, which routes them.
    "not_found_handling": "single-page-application",
    // Only API requests run the Worker code; everything else is served as files.
    "run_worker_first": ["/api/*"]
  },
  // Local `npm run dev:proxy`. Not 8787: another project on the owner's computer uses it.
  "dev": { "port": 8790 },
  // Daily AI limits per device and network (docs/02). Tables: apps/proxy/migrations.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maths-for-economics",
      "database_id": "5edb9c1c-eb2e-470e-ab95-73604228e21a",
      "migrations_dir": "./apps/proxy/migrations"
    }
  ],
  // Shared cache of AI answers that are the same for every student (docs/03).
  "kv_namespaces": [{ "binding": "AI_CACHE", "id": "e1cd6357fd424238a066ebbdacd90a2e" }]
  // GROQ_API_KEY and GEMINI_API_KEY are secrets on this Worker (Settings, Variables and
  // Secrets). Never put them in a file.
}
