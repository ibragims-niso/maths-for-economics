{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // One Worker serves the web app (apps/web, static files) and its API (apps/proxy, under /api).
  // Cloudflare builds it with `npm run build` and deploys it with `npx wrangler deploy`
  // from the repository root.
  "name": "maths-for-economics",
  "main": "./apps/proxy/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/web/dist",
    // Unknown paths (e.g. the mentor view /m/<token>) load the app, which routes them.
    "not_found_handling": "single-page-application",
    // Only API requests run the Worker code; everything else is served as files.
    "run_worker_first": ["/api/*"]
  },
  // Local `npm run dev:proxy`. Not 8787: another project on the owner's computer uses it.
  "dev": { "port": 8790 }
  // GROQ_API_KEY is a secret on this Worker (Settings, Variables and Secrets).
  // Never put it in a file.
}
