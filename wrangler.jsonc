{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The web app (apps/web), served as static files by Cloudflare Workers.
  // Cloudflare builds it with `npm run build` and deploys it with `npx wrangler deploy`
  // from the repository root. The AI proxy has its own config in apps/proxy/wrangler.jsonc.
  "name": "maths-for-economics",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/web/dist",
    // Unknown paths (e.g. the mentor view /m/<token>) load the app, which routes them.
    "not_found_handling": "single-page-application"
  }
}
